{
  "name": "halal-scout-nyc",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // 2-core keeps you at ~90 hrs/month against the 180 included core-hours.
  "hostRequirements": {
    "cpus": 2
  },

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "forwardPorts": [8000, 8501],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI (make api)",
      "onAutoForward": "notify"
    },
    "8501": {
      "label": "Streamlit (make ui)",
      "onAutoForward": "openPreview"
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "waitFor": "postCreateCommand",

  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:HOME}/.local/bin:${containerEnv:PATH}",
    // Mirrors ci.yml so import-time env checks do not crash before secrets are set.
    // Real keys come from Codespaces secrets, which override this file.
    "GEMINI_MODEL": "gemini-2.5-flash-lite"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        }
      }
    }
  }
}
